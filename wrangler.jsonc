{
  "name": "neighbors-of-2411",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-18",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    // Send /api/* to the Worker BEFORE the asset server sees it. The asset
    // server replies to any non-GET with a bare 405, which is how sign-up
    // POSTs to a near-miss path (e.g. a trailing slash) failed in Sept 2026.
    "run_worker_first": ["/api/*"]
  },
  // Duplicate-check storage for POST /api/sign: the "SIGNERS" KV namespace
  // (Cloudflare dashboard -> Storage & Databases -> KV). Only SHA-256 hashes
  // of "petition:<email>" are stored, never addresses. If this binding is
  // ever removed, the Worker fails open -- signatures are still recorded,
  // just without this duplicate check.
  // Where /api/sign records signatures: the "Neighbors of 2411 - Automation"
  // Apps Script web app (WebSignup.gs, owned by neighborsof2411@gmail.com).
  // Public on purpose -- it rejects any request without SIGNUP_SECRET, which
  // is a Cloudflare secret (Workers > neighbors-of-2411 > Settings >
  // Variables and Secrets), never committed here. If either is missing, the
  // Worker falls back to Formspree.
  "vars": {
    "SIGNUP_WEBAPP_URL": "https://script.google.com/macros/s/AKfycbx5HvwPS3ePuwyyQAzXa-sK3QLbD-TbwOh5PLVnTEm0T298JjEOtLAABXqccezZ3oOv1w/exec"
  },
  "kv_namespaces": [
    { "binding": "SIGNERS", "id": "b35808076168429f8ecf8ef902f04b8b" }
  ]
}
